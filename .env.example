# Copier en .env et renseigner les valeurs (ne jamais committer de secret).
# docker compose lit ce fichier automatiquement.

POSTGRES_USER=memequizz
POSTGRES_PASSWORD=changeme
POSTGRES_DB=memequizz

# Utilisé quand l'app tourne hors Docker (bun run dev) ; dans compose,
# DATABASE_URL est recalculé pour pointer vers le service `db`.
DATABASE_URL=postgres://memequizz:changeme@localhost:5432/memequizz

# Test de migration (bun run db:test). ATTENTION : le schéma public de cette
# base est supprimé à chaque exécution. Base locale dont le nom finit par _test.
# TEST_DATABASE_URL=postgres://memequizz:changeme@localhost:5432/memequizz_test
